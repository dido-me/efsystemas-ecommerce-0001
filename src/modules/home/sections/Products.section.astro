---
import CardProduct from '@src/components/CardProduct.component.astro'
import fetchApi from '@src/utils/strapi'
import type { ProductDTO } from '@src/interfaces/ProductoDto'

interface Props {
  title: string;
  collectionId: string | null;
  filterType?: 'categoria' | 'marca';
}

const { collectionId, title, filterType = 'categoria' } = Astro.props as Props

// Build query parameters for Strapi API
const query: Record<string, string> = {
  'populate[0]': 'categorias',
  'populate[1]': 'marca',
  'populate[2]': 'imagenes',
  'sort[0]': 'createdAt:desc',
  'pagination[limit]': '10'
}

// Add filter based on filterType only if collectionId is provided
if (collectionId !== null) {
  if (filterType === 'marca') {
    query['filters[marca][nombre][$eq]'] = collectionId
  } else {
    query['filters[categorias][nombre][$eq]'] = collectionId
  }
}

const products = await fetchApi<ProductDTO[]>({
  endpoint: 'productos',
  query,
  wrappedByKey: 'data'
}).catch((error) => {
  console.error('Error retrieving products:', error)
  return []
});
---

<div
  class="my-14 max-w-screen-xl mx-4 md:mx-auto text-center md:text-left flex flex-col gap-10"
>
  <header class="flex flex-wrap justify-between">
    <h3 class="text-2xl font-semibold text-commerce-950">
      {title}
    </h3>
    <a
      href="/shop"
      class="bg-commerce-500 text-white font-semibold text-sm px-4 py-2 rounded-lg hover:bg-commerce-700 transition-colors duration-300"
    >
      Ver mas
    </a>
  </header>
  <main
    class="grid gap-4 grid-cols-[repeat(auto-fill,minmax(15rem,1fr))] grid-rows-[masonry] auto-rows-max"
  >
    {
      products.map((product) => {
        // Función para encontrar la primera imagen (no video) en el array
        const getFirstImageUrl = () => {
          if (!product.imagenes || product.imagenes.length === 0) {
            return '/producto/placehold.png'
          }

          // Buscar la primera imagen que no sea un video
          const firstImage = product.imagenes.find(imagen =>
            imagen.mime && !imagen.mime.startsWith('video/')
          )

          return firstImage?.url ?? '/producto/placehold.png'
        }

        return (
          <CardProduct
            idProduct={product.documentId ?? ''}
            title={product.nombre ?? ''}
            description={product.descripcion_corta ?? ''}
            handle={product.slug ?? ''}
            imageProduct={getFirstImageUrl()}
            price={product.precio ?? 0}
          />
        )
      })
    }
  </main>
</div>
