---
import '@fontsource-variable/onest'
import ContactStrip from '@src/components/ContactStrip.component.astro'
import Footer from '@src/components/Footer.component.astro'
import GoogleAnalytics from '@src/components/GoogleAnalytics.component.astro'
import Header from '@src/components/Header.component.astro'
import { CartDrawer } from '@src/components/react'
import WhatsappFloatButton from '@src/components/WhatsappFloatButton.component.astro'
import { keywords } from '@src/consts/keyWords.const'

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  type?: 'website' | 'article' | 'product';
  siteName?: string;
  price?: number;
  currency?: string;
  availability?: 'in stock' | 'out of stock';
  brand?: string;
}

const {
  title,
  description = `Encuentra los mejores suministros de computadora y tecnología, con un enfoque en productos HP como tintas, tóneres, impresoras y más. Otros productos incluyen laptops, componentes de PC y accesorios: ${keywords}.`,
  image = '/images/logo.png',
  url = Astro.url.href,
  type = 'website',
  siteName = 'EF SYSTEMAS EIRL',
  price,
  currency = 'USD',
  availability = 'in stock',
  brand
} = Astro.props as Props

// Ensure image URL is absolute
const absoluteImageUrl = image?.startsWith('http') ? image : new URL(image || '/images/logo.png', Astro.url.origin).href

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Basic Meta Tags -->
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph Meta Tags for Facebook, WhatsApp, etc. -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    <!-- Product-specific Meta Tags (if it's a product) -->
    {type === 'product' && (
      <>
        {price && <meta property="product:price:amount" content={price.toString()} />}
        <meta property="product:price:currency" content={currency} />
        <meta property="product:availability" content={availability} />
        {brand && <meta property="product:brand" content={brand} />}
      </>
    )}

    <GoogleAnalytics />
  </head>
  <body>
    <Header />
    <CartDrawer client:only="react" />
    <ContactStrip />
    <main class="mx-5">
      <slot />
    </main>
    <ContactStrip />
    <Footer />
    <WhatsappFloatButton />
  </body>
</html>
<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Onest Variable", sans-serif;
    background: #e9f7ff;
    overflow-x: hidden;
    padding-top: 4.5rem;
  }
</style>
