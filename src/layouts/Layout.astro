---
import '@fontsource-variable/onest'
import ContactStrip from '@src/components/ContactStrip.component.astro'
import Footer from '@src/components/Footer.component.astro'
import GoogleAnalytics from '@src/components/GoogleAnalytics.component.astro'
import Header from '@src/components/Header.component.astro'
import { CartDrawer } from '@src/components/react'
import WhatsappFloatButton from '@src/components/WhatsappFloatButton.component.astro'
import { keywords } from '@src/consts/keyWords.const'
import { SEO } from 'astro-seo'

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  type?: 'website' | 'article' | 'product';
  siteName?: string;
  price?: number;
  currency?: string;
  availability?: 'in stock' | 'out of stock';
  brand?: string;
}

const {
  title,
  description = `Encuentra los mejores suministros de computadora y tecnología, con un enfoque en productos HP como tintas, tóneres, impresoras y más. Otros productos incluyen laptops, componentes de PC y accesorios: ${keywords}.`,
  image = '/producto/placehold.png',
  url = Astro.url.href,
  type = 'website',
  siteName = 'EF SYSTEMAS EIRL',
  price,
  currency = 'USD',
  availability = 'in stock',
  brand
} = Astro.props as Props

// Ensure image URL is absolute
const absoluteImageUrl = image?.startsWith('http') ? image : new URL(image || '/producto/placehold.png', Astro.url.origin).href

// Prepare Open Graph data
const openGraph = {
  basic: {
    title,
    type: type as 'website' | 'article' | 'product' | 'object',
    image: absoluteImageUrl,
    url
  },
  optional: {
    description,
    siteName,
    locale: 'es_PE'
  },
  image: {
    url: absoluteImageUrl,
    width: 1200,
    height: 630,
    alt: title
  },
  article: type === 'article'
    ? {
        publishedTime: new Date().toISOString(),
        modifiedTime: new Date().toISOString(),
        section: 'Productos',
        tags: ['tecnología', 'computadora', 'suministros']
      }
    : undefined
}

// Twitter Card data
const twitter = {
  card: 'summary_large_image' as const,
  site: '@efsystemas',
  creator: '@efsystemas',
  title,
  description,
  image: absoluteImageUrl,
  imageAlt: title
}

// Additional meta tags for products
const extend = type === 'product'
  ? {
      meta: [
        ...(price ? [{ name: 'product:price:amount', content: price.toString() }] : []),
        { name: 'product:price:currency', content: currency },
        { name: 'product:availability', content: availability },
        ...(brand ? [{ name: 'product:brand', content: brand }] : [])
      ]
    }
  : {}

---

<!doctype html>
<html lang="es">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={url}
      openGraph={openGraph}
      twitter={twitter}
      extend={extend}
    />
    <meta charset="UTF-8" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <GoogleAnalytics />
  </head>
  <body>
    <Header />
    <CartDrawer client:only="react" />
    <ContactStrip />
    <main class="mx-5">
      <slot />
    </main>
    <ContactStrip />
    <Footer />
    <WhatsappFloatButton />
  </body>
</html>
<style is:global>
  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Onest Variable", sans-serif;
    background: #e9f7ff;
    overflow-x: hidden;
    padding-top: 4.5rem;
  }
</style>
