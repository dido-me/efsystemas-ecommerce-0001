---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'section'> {
  brandName: string;
  brandLogo?: string;
  brandImage?: string;
  tagline?: string;
  description?: string;
  ctaText?: string;
  ctaLink?: string;
  backgroundImage?: string;
  featured?: boolean;
}

const {
  brandName,
  brandLogo,
  brandImage,
  tagline = 'Tecnología que impulsa tu éxito',
  description = 'Descubre la calidad y innovación que solo una marca líder puede ofrecerte',
  ctaText = 'Ver Productos',
  ctaLink = '/shop',
  backgroundImage,
  featured = false,
  ...attrs
} = Astro.props as Props

// Construir URL con parámetros de marca
const buildShopUrl = () => {
  if (ctaLink !== '/shop') return ctaLink

  const url = new URL('/shop', Astro.url.origin)
  if (brandName) {
    url.searchParams.set('marca', brandName)
  }
  return url.pathname + url.search
}

const finalCtaLink = buildShopUrl()

const heroClasses = [
  'relative overflow-hidden rounded-xl shadow-lg transition-all duration-500 hover:shadow-xl z-[1] my-3',
  featured ? 'bg-gradient-to-br from-blue-600 via-blue-700 to-blue-800' : 'bg-gradient-to-br from-gray-800 via-gray-900 to-black',
  featured ? 'border-2 border-yellow-400' : 'border border-gray-600'
];
---

<section class:list={heroClasses} {...attrs}>
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 20px 20px;"></div>
  </div>

  <!-- Background Image Overlay -->
  {backgroundImage && (
    <div class="absolute inset-0">
      <img
        src={backgroundImage}
        alt={`${brandName} background`}
        class="w-full h-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 to-transparent"></div>
    </div>
  )}

  <!-- Content -->
  <div class="relative z-10 p-4 md:p-6 lg:p-8">
    <div class="max-w-4xl mx-auto">
      <!-- Featured Badge -->
      {featured && (
        <div class="inline-flex items-center gap-2 bg-yellow-400 text-black px-3 py-1 rounded-full text-xs font-bold mb-3 animate-pulse">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          MARCA DESTACADA
        </div>
      )}

      <div class="grid lg:grid-cols-2 gap-4 items-center">
        <!-- Text Content -->
        <div class="text-white space-y-3">
          <!-- Brand Logo -->
          {brandLogo && (
            <div class="mb-3">
              <img
                src={brandLogo}
                alt={`${brandName} logo`}
                class="h-10 md:h-12 w-auto filter brightness-0 invert"
              />
            </div>
          )}

          <!-- Brand Name -->
          <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold leading-tight">
            Productos
            <span class:list={[
              'block text-transparent bg-clip-text',
              featured ? 'bg-gradient-to-r from-yellow-300 to-yellow-500' : 'bg-gradient-to-r from-blue-400 to-purple-500'
            ]}>
              {brandName}
            </span>
          </h1>

          <!-- Tagline -->
          <p class="text-lg md:text-xl font-medium text-gray-200">
            {tagline}
          </p>

          <!-- Description -->
          <p class="text-base text-gray-300 leading-relaxed max-w-lg">
            {description}
          </p>

          <!-- CTA Button -->
          <div class="pt-2">
            <a
              href={finalCtaLink}
              class:list={[
                'inline-flex items-center gap-2 px-6 py-3 rounded-lg font-semibold text-base transition-all duration-300 transform hover:scale-105 hover:shadow-lg',
                featured
                  ? 'bg-yellow-400 text-black hover:bg-yellow-300 shadow-yellow-400/25'
                  : 'bg-white text-gray-900 hover:bg-gray-100 shadow-white/25'
              ]}
            >
              {ctaText}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Visual Element -->
        <div class="relative">
          <div class:list={[
            'w-32 h-32 md:w-40 md:h-40 mx-auto rounded-full border-2 flex items-center justify-center',
            featured ? 'border-yellow-400' : 'border-white'
          ]}>
            <img
              src={brandImage}
              alt={`${brandName} logo`}
              class="w-16 h-16 md:w-20 md:h-20 object-contain filter brightness-0 invert"
            />
          </div>

          <!-- Floating Elements -->
          <div class="absolute -top-2 -right-2 w-8 h-8 bg-white/10 rounded-full animate-bounce delay-100"></div>
          <div class="absolute -bottom-2 -left-2 w-6 h-6 bg-white/10 rounded-full animate-bounce delay-300"></div>
          <div class="absolute top-1/2 -left-4 w-4 h-4 bg-white/10 rounded-full animate-bounce delay-500"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Gradient -->
  <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-black/20 to-transparent"></div>
</section>
