---

import type { HTMLAttributes } from 'astro/types'
import { ProductButton } from '@src/modules/producto/components/react/ProductButton.component'

interface Props extends HTMLAttributes<'article'> {
  title: string;
  description: string;
  price: number;
  priceAfter?: number;
  handle: string;
  idProduct: string;
  imageProduct: string;
  brand?: string;
  category?: string;
  featured?: boolean;
  discount?: number;
  inStock?: boolean;
  rating?: number;
  reviewCount?: number;
}

const {
  title,
  description,
  price,
  priceAfter,
  handle,
  idProduct,
  imageProduct,
  brand,
  category,
  featured = false,
  discount,
  inStock = true,
  rating,
  reviewCount,
  ...attrs
} = Astro.props as Props

const priceFormat = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD'
}).format(price)

const priceAfterFormat = priceAfter
  ? new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD'
  }).format(priceAfter)
  : null

const discountPercentage = priceAfter ? Math.round(((priceAfter - price) / priceAfter) * 100) : discount

const cardClasses = [
  'group relative bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2 overflow-hidden border',
  featured ? 'border-2 border-yellow-400 ring-4 ring-yellow-400/20' : 'border-gray-200 hover:border-commerce-300',
  !inStock ? 'opacity-75' : ''
]

const truncatedDescription = description.length > 80 ? `${description.substring(0, 80)}...` : description;
---
<article class:list={cardClasses} {...attrs}>
  <!-- Featured Badge -->
  {featured && (
    <div class="absolute top-4 left-4 z-20 bg-gradient-to-r from-yellow-400 to-yellow-500 text-black px-3 py-1 rounded-full text-xs font-bold shadow-lg">
      ⭐ DESTACADO
    </div>
  )}

  <!-- Discount Badge -->
  {discountPercentage && discountPercentage > 0 && (
    <div class="absolute top-4 right-4 z-20 bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
      -{discountPercentage}%
    </div>
  )}

  <!-- Stock Status -->
  {!inStock && (
    <div class="absolute inset-0 z-30 bg-black/50 flex items-center justify-center">
      <div class="bg-red-600 text-white px-6 py-3 rounded-lg font-bold text-lg">
        AGOTADO
      </div>
    </div>
  )}

  <!-- Image Container -->
  <div class="relative aspect-square overflow-hidden bg-gray-50">
    <a href={`/product/${idProduct}/${handle}`} class="block h-full">
      <img
        src={imageProduct}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
        loading="lazy"
      />

      <!-- Image Overlay on Hover -->
      <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>

      <!-- Quick View Button -->
      <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <button class="bg-white/90 backdrop-blur-sm text-gray-900 px-4 py-2 rounded-lg font-semibold shadow-lg transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
          Vista Rápida
        </button>
      </div>
    </a>
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col h-full">
    <!-- Brand & Category -->
    <div class="flex items-center justify-between mb-3">
      {brand && (
        <span class="text-sm font-semibold text-commerce-600 uppercase tracking-wide">
          {brand}
        </span>
      )}
      {category && (
        <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded-full">
          {category}
        </span>
      )}
    </div>

    <!-- Title -->
    <h3 class="mb-3 flex-grow">
      <a
        href={`/product/${idProduct}/${handle}`}
        class="text-lg font-bold text-gray-900 hover:text-commerce-600 transition-colors duration-200 line-clamp-2"
      >
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-gray-600 text-sm mb-4 line-clamp-3 leading-relaxed">
      {truncatedDescription}
    </p>

    <!-- Rating -->
    {rating && (
      <div class="flex items-center gap-2 mb-4">
        <div class="flex items-center">
          {Array.from({ length: 5 }, (_, i) => (
            <svg
              class={`w-4 h-4 ${i < Math.floor(rating) ? 'text-yellow-400' : 'text-gray-300'}`}
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        {reviewCount && (
          <span class="text-sm text-gray-500">({reviewCount})</span>
        )}
      </div>
    )}

    <!-- Price Section -->
    <div class="mb-6">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-2xl font-bold text-gray-900">{priceFormat}</span>
        {priceAfterFormat && (
          <span class="text-lg text-gray-500 line-through">{priceAfterFormat}</span>
        )}
      </div>

      {discountPercentage && discountPercentage > 0 && (
        <p class="text-sm text-green-600 font-semibold">
          ¡Ahorras {priceAfterFormat
          ? new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD'
          }).format(priceAfter! - price)
          : `${discountPercentage}%`}!
        </p>
      )}
    </div>

    <!-- Action Button -->
    <div class="mt-auto">
      {inStock
        ? (
        <ProductButton {...Astro.props} client:visible />
          )
        : (
        <button
          disabled
          class="w-full bg-gray-300 text-gray-500 py-3 px-6 rounded-xl font-semibold cursor-not-allowed"
        >
          No Disponible
        </button>
          )}
    </div>
  </div>

  <!-- Hover Effect Border -->
  <div class="absolute inset-0 rounded-2xl border-2 border-transparent group-hover:border-commerce-200 transition-colors duration-300 pointer-events-none"></div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
